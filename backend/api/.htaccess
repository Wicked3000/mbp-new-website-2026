# Authorization header forwarding only. CORS is set by config/cors.php, which
# allowlists origins; a wildcard here would silently override that allowlist and
# hand any website access to the admin API.
CGIPassAuth On
RewriteEngine On
RewriteCond %{HTTP:Authorization} ^(.*)
RewriteRule ^(.*) - [E=HTTP_AUTHORIZATION:%1]
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
