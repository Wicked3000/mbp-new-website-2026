# The API is a Next.js Route Handler in this same app, so there is no API base
# URL to configure and no second process to start. `next dev` serves the site and
# /api/* together on one port.
#
# NEXT_PUBLIC_API_BASE only needs changing if the API is ever split onto another
# origin. Leave it unset: a relative "/api" keeps every call same-origin, which
# is what lets the admin session be a plain SameSite cookie with no CORS.
# NEXT_PUBLIC_API_BASE=/api

# Used for absolute URLs in metadata (og:image, canonical). Set it to the real
# origin in production or social previews resolve against localhost.
# NEXT_PUBLIC_SITE_URL=https://mbpeducation.gov.pg

# Port for both `next dev` and `next start`.
PORT=3000

# --- Database -------------------------------------------------------------
# The pool is created in lib/db.ts and cached on globalThis so hot reloads do not
# leak connections. Schema is applied separately: `npm run db:ensure`.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mbp_education

# REQUIRED in production (NODE_ENV=production). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Tokens are refused outright in production without it.
# The value below is the published development default - never deploy with it.
JWT_SECRET=mbp_education_dev_secret_change_me_32chars

# Only needed when the app sits behind Apache/nginx or a load balancer: it makes
# rate limiting key on the real client address instead of the proxy's. Without it
# every request shares one bucket, and one admin hammering the login page locks
# out the whole site.
# TRUSTED_PROXY=1

# --- Uploads --------------------------------------------------------------
# Admin uploads are written to public/uploads and served from this origin. That
# requires a PERSISTENT, WRITABLE filesystem. It rules out Vercel and any other
# serverless runtime, where the write is discarded when the invocation ends and
# the image 404s while the API reported success.
#
# public/uploads is committed to git (see .gitignore) so a file uploaded on the
# live server still survives a redeploy from a clean checkout.
UPLOAD_MAX_BYTES=26214400
