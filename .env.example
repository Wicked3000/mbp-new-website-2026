# Relative path. Works on localhost (Vite proxies /api -> :3001) and on any
# deployed host. A static host with no API 404s these and falls back to seeds.
VITE_API_BASE=/api
# Dev: Node API on :3001 proxied via Vite (:8443) -> only XAMPP MySQL needed
# Legacy PHP: VITE_API_BASE=http://localhost/mbp-api
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mbp_education
API_PORT=3001

# REQUIRED in production (NODE_ENV=production). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The API refuses to start in production without a secret of at least 32 chars.
# The value below is the published development default - never deploy with it.
JWT_SECRET=mbp_education_dev_secret_change_me_32chars

# Comma-separated browser origins allowed to call the API with credentials.
# Add the real site origin in production, e.g.
#   CORS_ORIGINS=https://mbpeducation.gov.pg,https://www.mbpeducation.gov.pg
CORS_ORIGINS=http://localhost:8443,http://127.0.0.1:8443,http://localhost:5173,http://127.0.0.1:5173
